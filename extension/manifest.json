{
  "manifest_version": 3,
  "name": "Aladdin AI — Zerodha Kite Stock Intelligence & Breakout Screener",
  "version": "1.0.0",
  "description": "Real-time AI stock intelligence overlay for Zerodha Kite. Features AI confluence scores, F&O strike calls, watchlist scanner, and penny stock breakout rankings.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://kite.zerodha.com/*"],
      "css": ["contentStyle.css"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Aladdin AI — Zerodha Kite Intelligence"
  }
}
